# Copier ce fichier vers .env.local et remplir avec vos vraies valeurs
# NE JAMAIS committer .env.local !

# Secret partagé entre le client et /api/sync (garde légère, même modèle que
# VITE_ACCESS_PASSWORD : visible dans le bundle, vérifiée côté serveur pour
# empêcher le scan automatique de la route de sync)
VITE_SYNC_GATE_KEY=

# Le token GitHub (scope "gist") et l'ID du Gist vivent désormais côté
# serveur uniquement (fonction Vercel api/sync.js) : SYNC_GITHUB_TOKEN et
# SYNC_GIST_ID, posés dans le dashboard Vercel (Project Settings →
# Environment Variables), jamais préfixés VITE_. Pour tester en local avec
# `vercel dev`, ajouter ici aussi :
# SYNC_GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# SYNC_GIST_ID=

# Auto-sync activé (true/false)
VITE_AUTO_SYNC_ENABLED=true

# Intervalle d'auto-sync en minutes (défaut: 10)
VITE_AUTO_SYNC_INTERVAL=10